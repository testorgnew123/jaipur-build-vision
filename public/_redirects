# Exact API routes - must come before wildcards
/api/auth         /.netlify/functions/auth         200
/api/posts        /.netlify/functions/posts        200
/api/visits       /.netlify/functions/visits       200
/api/users        /.netlify/functions/users        200
/api/jobs         /.netlify/functions/jobs         200

# Wildcard item routes
/api/posts/*      /.netlify/functions/posts-slug   200
/api/visits/*     /.netlify/functions/visits-id    200
/api/users/*      /.netlify/functions/users-id     200
/api/jobs/*       /.netlify/functions/jobs-id      200

# Vite dev server modules. Netlify Dev applies this file locally too, so these
# must pass through before the SPA fallback or JS module requests receive HTML.
/@vite/*          /@vite/:splat                    200
/@react-refresh   /@react-refresh                  200
/@id/*            /@id/:splat                      200
/@fs/*            /@fs/:splat                      200
/src/*            /src/:splat                      200
/node_modules/*   /node_modules/:splat             200

# SPA fallback - must be last
/*                /index.html                      200
